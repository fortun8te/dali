+// DALI patch: response handler for keep-alive OPTIONS requests. Deliberately
+// NON-FATAL: a lost keep-alive (one stalled RTSP request on a congested
+// 2.4GHz link) must not kill a healthy audio stream — a genuinely dead
+// connection is still caught by raop_rtsp_close_cb.
+static void
+raop_cb_keep_alive(struct evrtsp_request *req, void *arg)
+{
+  struct raop_session *rs = arg;
+
+  rs->reqs_in_flight--;
+
+  if (!req)
+    {
+      // Review fix (MEDIUM-3): req == NULL is not a soft timeout — per the
+      // evrtsp contract it means the CONNECTION errored and was reset. The old
+      // "proceeding anyway" left the session in STREAMING on a dead connection
+      // forever: audio silently gone, and because the state never became
+      // STOPPED/FAILED, no resurrect path could ever rescue it. Declare the
+      // failure so the normal teardown -> FAILED -> reconnect machinery runs.
+      DPRINTF(E_WARN, L_RAOP, "Keep-alive OPTIONS to '%s' got no response (connection dead) - failing session for reconnect\n", rs->devname);
